{
  "name": "@onlicert/desktop",
  "version": "0.1.8",
  "private": true,
  "description": "OnliCert Manager Desktop Application",
  "main": "dist-electron/main.js",
  "homepage": "https://github.com/onlitec/OnliCerManager",
  "author": {
    "name": "OnliCert Manager Contributors",
    "email": "galvatec@gmail.com"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/onlitec/OnliCerManager.git"
  },
  "scripts": {
    "dev": "vite",
    "generate-pdf": "node scripts/generate_pdf_manual.js",
    "build": "node ../../scripts/fetch_openssl_windows.js && node scripts/generate_pdf_manual.js && tsc -p tsconfig.node.json && vite build && electron-builder",
    "build:renderer": "vite build",
    "build:electron": "tsc -p tsconfig.node.json",
    "preview": "vite preview",
    "lint": "eslint src electron --ext .ts,.tsx",
    "lint:fix": "eslint src electron --ext .ts,.tsx --fix",
    "typecheck": "tsc -p tsconfig.node.json && tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "clean": "rimraf dist dist-electron out coverage"
  },
  "dependencies": {
    "@onlicert/core": "workspace:*",
    "@onlicert/infrastructure": "workspace:*",
    "@onlicert/plugin-interface": "workspace:*",
    "@onlicert/plugin-mikrotik": "workspace:*",
    "@onlicert/plugin-proxmox": "workspace:*",
    "@radix-ui/react-alert-dialog": "^1.1.0",
    "@radix-ui/react-avatar": "^1.1.0",
    "@radix-ui/react-dialog": "^1.1.0",
    "@radix-ui/react-dropdown-menu": "^2.1.0",
    "@radix-ui/react-label": "^2.1.0",
    "@radix-ui/react-progress": "^1.1.0",
    "@radix-ui/react-scroll-area": "^1.2.0",
    "@radix-ui/react-select": "^2.1.0",
    "@radix-ui/react-separator": "^1.1.0",
    "@radix-ui/react-slot": "^1.1.0",
    "@radix-ui/react-switch": "^1.1.0",
    "@radix-ui/react-tabs": "^1.1.0",
    "@radix-ui/react-toast": "^1.2.0",
    "@radix-ui/react-tooltip": "^1.1.0",
    "class-variance-authority": "^0.7.0",
    "clsx": "^2.1.0",
    "electron-updater": "^6.3.0",
    "i18next": "^23.16.0",
    "lucide-react": "^0.469.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "react-hook-form": "^7.54.0",
    "react-i18next": "^15.2.0",
    "react-router-dom": "^7.1.0",
    "tailwind-merge": "^2.6.0",
    "winston": "^3.17.0",
    "zod": "^3.24.0",
    "zustand": "^5.0.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.49.0",
    "@types/node": "^22.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^4.3.0",
    "autoprefixer": "^10.4.0",
    "electron": "^33.0.0",
    "electron-builder": "^25.1.0",
    "eslint-config-prettier": "^9.1.0",
    "pdfkit": "^0.19.1",
    "postcss": "^8.4.0",
    "rimraf": "^6.0.0",
    "tailwindcss": "^3.4.0",
    "typescript": "^5.5.0",
    "typescript-eslint": "^8.0.0",
    "vite": "^6.0.0",
    "vite-plugin-electron": "^0.28.0",
    "vite-plugin-electron-renderer": "^0.14.0",
    "vitest": "^2.1.0"
  },
  "build": {
    "extends": "../../electron-builder.yml"
  }
}
